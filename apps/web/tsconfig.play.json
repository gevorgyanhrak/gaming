{
  // The house slot clients under play/ (APEXSLOTS open-source code, ADR 0024): their own settings, as upstream,
  // plus our "@/..." alias for the shared API bridge.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.play.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["play", "src/vite-env.d.ts"]
}
