# Base URL of the Laravel API, without a trailing slash.
# Leave empty in local development: Vite proxies /api, /sanctum and /broadcasting to API_PROXY_TARGET.
# Production example: https://api.example.com
VITE_API_BASE_URL=

# Dev/preview server proxy target (read by vite.config.ts only; never exposed to the browser).
API_PROXY_TARGET=http://localhost:8000

# Reverb (WebSocket) connection used by the browser. The key is the API's REVERB_APP_KEY (public);
# never put REVERB_APP_SECRET here.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
