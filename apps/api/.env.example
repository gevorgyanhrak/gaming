APP_NAME="Game Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin of the React SPA. Used for CORS and Sanctum stateful (cookie) authentication.
FRONTEND_URL=http://localhost:5175

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Comma-separated list of locales the API serves (Accept-Language is matched against it).
APP_SUPPORTED_LOCALES=en,ru,hy

APP_MAINTENANCE_DRIVER=file

# Password hashing. Argon2id is the recommended algorithm (OWASP).
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# Platform behaviour (managed from the admin panel from Phase 4)
REGISTRATION_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_PHONE_VERIFICATION=true
# ISO country codes allowed for phone registration, e.g. AM,GE,RU. Empty allows any country.
PHONE_ALLOWED_COUNTRIES=

# Admin panel (Filament) at /admin. ADMIN_DOMAIN serves it on its own host instead (e.g. admin.example.com).
ADMIN_DOMAIN=
# Two-factor authentication for admins. Keep true outside local development.
ADMIN_MFA_REQUIRED=true

# SMS provider for phone verification codes. "log" writes messages to the log (development only;
# it refuses to run in production). A real provider is added once launch countries are decided.
SMS_DRIVER=log

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# When running through Docker Compose, DB_*, REDIS_HOST and MAIL_HOST/PORT are injected by compose.yaml
# and take precedence over the values below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=game_platform
DB_USERNAME=game
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Host:port pairs whose requests are authenticated with session cookies (the SPA).
SANCTUM_STATEFUL_DOMAINS=localhost:5175

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=gp_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Production: queues, Horizon, locks and live game state need Redis without eviction (REDIS_HOST, and
# optionally REDIS_GAME_HOST); cache, sessions and rate limits go to a separate allkeys-lru instance.
# REDIS_CACHE_HOST=cache-redis.internal
# REDIS_GAME_HOST=game-redis.internal

# Behind a load balancer / TLS terminator: its IPs or CIDRs (comma-separated), or * (see config/platform.php).
TRUSTED_PROXIES=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverb (WebSocket server). Generate real values per environment; never reuse these.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
