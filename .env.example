# Docker Compose infrastructure for LOCAL DEVELOPMENT ONLY.
# Copy to .env. Never reuse these values in any shared or production environment.

API_PORT=8000
REVERB_PORT=8080
MYSQL_PORT=3307
REDIS_PORT=6380
MAILPIT_UI_PORT=8025

DB_DATABASE=game_platform
DB_USERNAME=game
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret

# Shared key between the API and the internal slot engine (ADR 0026); 32+ characters, a long random value in production.
SLOT_ENGINE_KEY=
